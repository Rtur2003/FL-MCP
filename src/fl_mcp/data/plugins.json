    "fruity stereo shaper": {
      "routing": {
        "0.5": "Neutral (no phase invert)"
      },
      "note": "Keep L/R matrix at unity (0.5) unless intentional M/S split; inverted levels cause -16 dB phase cancellation."
    },
    "fruity limiter": {
      "curve": "1-8 attack/release tension curve; ATT is look-ahead latency (PDC). Set CEIL=-1.0 dBTP.",
      "comp_only": "Set Limiter CEIL to max and ATT to 0 ms.",
      "limit_only": "Set Compressor THRES to max."
    },
    "fruity reeverb 2": {
      "room_size": "Unitless display 0..100 (pass Room size=80 directly in fl_param settings).",
      "send_bus": "Set DRY=0%, WET=100% (or binary v[8]=115..125) on dedicated send tracks."
    }
  },
