  "recipes": {
    "kick": {
      "want": [
        "comp"
      ],
      "set": {
        "comp": {
          "threshold": "-12 dB",
          "ratio": "3:1",
          "attack": "15 ms",
          "release": "80 ms"
        }
      },
      "why": "Gentle control so the kick hits the same every bar; keep the transient (attack 10-30 ms)."
    },
    "snare": {
      "want": [
        "comp"
      ],
      "set": {
        "comp": {
          "threshold": "-14 dB",
          "ratio": "4:1",
          "attack": "8 ms",
          "release": "100 ms"
        }
      },
      "why": "Fast enough to catch the body, slow enough to let the crack through."
    },
    "clap": {
      "want": [
        "comp"
      ],
      "set": {
        "comp": {
          "threshold": "-14 dB",
          "ratio": "3:1",
          "attack": "10 ms",
          "release": "90 ms"
        }
      },
      "why": "Light control; most of a clap's character is its reverb tail on a send."
    },
    "hat": {
      "want": [],
      "set": {},
      "why": "Usually no dynamics: high-pass and level are enough."
    },
    "ohat": {
      "want": [],
      "set": {},
      "why": "Same as the closed hat; a little reverb on a send."
    },
    "perc": {
      "want": [],
      "set": {},
      "why": "Pan and level first; add a send for space."
    },
    "bass": {
      "want": [
        "comp"
      ],
      "set": {
        "comp": {
          "threshold": "-18 dB",
          "ratio": "4:1",
          "attack": "20 ms",
          "release": "150 ms"
        }
      },
      "why": "Even out the low end so it sits steady under the kick; drive adds harmonics on small speakers."
    },
    "chords": {
      "want": [
        "comp"
      ],
      "set": {
        "comp": {
          "threshold": "-20 dB",
          "ratio": "2:1",
          "attack": "30 ms",
          "release": "200 ms"
        }
      },
      "why": "Light glue; a send reverb gives width without washing the mix."
    },
    "pad": {
      "want": [
        "reverb"
      ],
      "set": {
        "reverb": {
          "wet": "30%",
          "predelay": "30 ms"
        }
      },
      "why": "Pads live on space; keep the low end clean with a low cut."
    },
    "lead": {
      "want": [
        "comp",
        "delay"
      ],
      "set": {
        "comp": {
          "threshold": "-18 dB",
          "ratio": "3:1",
          "attack": "10 ms",
          "release": "120 ms"
        },
        "delay": {
          "feedback": "35%",
          "wet": "20%"
        }
      },
      "why": "Keep it in front with steady level; a delay (ideally on a send) adds depth."
    },
    "arp": {
      "want": [
        "delay"
      ],
      "set": {
        "delay": {
          "feedback": "30%",
          "wet": "25%"
        }
      },
      "why": "Rhythmic delay turns a simple arp into movement."
    },
    "fx": {
      "want": [],
      "set": {},
      "why": "Risers and impacts need level and reverb, not dynamics."
    },
    "drums": {
      "want": [
        "comp"
      ],
      "set": {
        "comp": {
          "threshold": "-16 dB",
          "ratio": "3:1",
          "attack": "30 ms",
          "release": "150 ms"
        }
      },
      "why": "Bus compression glues the kit; a slow attack keeps the transients."
    },
    "master": {
      "want": [
        "limiter"
      ],
      "set": {
        "limiter": {
          "ceiling": "-1.0 dB"
        }
      },
      "why": "A ceiling at -1 dB leaves room for lossy encoding; do not chase loudness before the mix is balanced."
    },
    "piano": {
      "want": [
        "eq"
      ],
      "set": {
        "comp": {
          "threshold": "-16 dB",
          "ratio": "1.7:1",
          "attack": "30 ms",
          "release": "150 ms"
        }
      },
      "why": "Keep concert/solo piano dynamics natural (<=2 dB GR, HPF 30-40 Hz, shared Room/Hall send)."
    },
    "strings": {
      "want": [
        "eq"
      ],
      "set": {
        "comp": {
          "threshold": "-20 dB",
          "ratio": "2:1",
          "attack": "35 ms",
          "release": "220 ms"
        }
      },
      "why": "Preserve bow swell and warm low-mids; send to shared concert hall rather than heavy insert reverb."
    },
    "winds": {
      "want": [
        "eq"
      ],
      "set": {
        "comp": {
          "threshold": "-20 dB",
          "ratio": "2:1",
          "attack": "25 ms",
          "release": "180 ms"
        }
      },
      "why": "Smooth breath dynamics gently without flattening phrase swells."
    },
    "acoustic_guitar": {
      "want": [
        "eq"
      ],
      "set": {
        "comp": {
          "threshold": "-18 dB",
          "ratio": "2.5:1",
          "attack": "20 ms",
          "release": "120 ms"
        }
      },
      "why": "Tame 120-250 Hz body resonance while keeping fingerstyle pluck transients."
    },
    "hall_send": {
      "want": [
        "reverb"
      ],
      "set": {
        "reverb": {
          "wet": "100%",
          "predelay": "35 ms",
          "lowcut": "200 Hz",
          "highcut": "6000 Hz"
        }
      },
      "why": "Dedicated reverb send bus MUST keep dry 0% and wet 100% with HPF 180-250 Hz."
    }
  },
